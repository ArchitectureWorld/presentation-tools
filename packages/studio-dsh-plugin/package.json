{
  "name": "@architectureworld/report-studio-dsh",
  "version": "0.1.1",
  "description": "Report Studio 0.2.0-alpha.3 native DSH Web profile plugin (compat package 0.1.1)",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**",
    "vendor/**",
    "compatibility/**",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "sync:vendor": "node ../../scripts/build-dsh-plugin-vendor.mjs",
    "prepack": "npm run sync:vendor"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "playwright-core": "1.63.0"
  },
  "license": "MIT"
}
