{
  "plugin": "@architectureworld/report-studio-dsh",
  "pluginVersion": "0.1.1",
  "reportStudioVersion": "0.2.0-alpha.3",
  "testedDshVersion": "0.1.5-rc.1",
  "testedProfile": "web",
  "testedNodeVersion": ">=24.11.0",
  "sessionFormat": "V3",
  "hostServices": ["tools", "webServer", "systemPrompt", "sessions", "llm", "sessionController", "sessionProjections", "agentDefaultModel"],
  "clientServices": ["slots", "sessions"],
  "clientPackages": [
    "@deepseek-ai/dsh-api-remotes",
    "@deepseek-ai/dsh-api-session-controller",
    "@deepseek-ai/dsh-client-ui-conversation",
    "@deepseek-ai/dsh-client-ui-renderer",
    "@deepseek-ai/dsh-client-ui-session"
  ],
  "clientSlots": ["conversation.view", "conversation.session.header.actions"],
  "routes": ["/report-studio"],
  "tools": ["studio_open_workspace_project", "studio_reload_upstream", "studio_get_context", "studio_apply_commands"],
  "designToolFamily": true
}
